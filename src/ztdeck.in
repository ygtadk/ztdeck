#!@PYTHON@
# ZTDeck launcher -- generated by Meson.
import gettext
import locale
import os
import signal
import sys

VERSION = '@VERSION@'
APP_ID = '@APP_ID@'
PKGDATA_DIR = '@PKGDATA_DIR@'
LOCALE_DIR = '@LOCALE_DIR@'
GETTEXT_PACKAGE = '@GETTEXT_PACKAGE@'

sys.path.insert(1, PKGDATA_DIR)

signal.signal(signal.SIGINT, signal.SIG_DFL)

# ztdeck.i18n reads this: gettext.translation() would otherwise look in
# sys.prefix/share/locale (/usr/share/locale inside the runtime) and quietly
# find nothing, because Meson installs the catalogues under the app prefix.
os.environ.setdefault('ZTDECK_LOCALE_DIR', LOCALE_DIR)

# Bind the domain for GTK's own C-side translations too.
try:
    locale.bindtextdomain(GETTEXT_PACKAGE, LOCALE_DIR)
    locale.textdomain(GETTEXT_PACKAGE)
except AttributeError:
    # locale.bindtextdomain is absent on some platforms; the Python-side
    # translations above still work.
    pass
gettext.bindtextdomain(GETTEXT_PACKAGE, LOCALE_DIR)
gettext.textdomain(GETTEXT_PACKAGE)

if __name__ == '__main__':
    from ztdeck import main
    sys.exit(main.run(VERSION, APP_ID))
